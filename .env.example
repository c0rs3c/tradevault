# Primary MongoDB connection for the default signed-in user.
MONGO_URI=mongodb://127.0.0.1:27017/trade-journal

# Dedicated shared MongoDB cluster for watchlists and news storage.
NEWS_MONGO_URI=mongodb://127.0.0.1:27017/trade-journal-news

# Quote provider:
# - local_python: use scripts/get_quote.py on this machine
# - remote_http: call a hosted quote service such as the Render Flask app
# If unset, development defaults to local_python.
# In production, the app auto-selects remote_http when QUOTE_SERVICE_URL is present.
QUOTE_PROVIDER=local_python

# Hosted quote service endpoint, for example:
# https://your-render-service.onrender.com
# or:
# https://your-render-service.onrender.com/quote
QUOTE_SERVICE_URL=

# Shared secret used by the hosted quote service.
# Set the same value in Render and in the main app environment (for example Vercel).
QUOTE_SERVICE_TOKEN=

# Python executable used only when QUOTE_PROVIDER=local_python.
MARKET_DATA_PYTHON=python3

# Primary login credentials for the app.
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_password

# Optional second user.
AUTH_USERNAME_2=your_second_username
AUTH_PASSWORD_2=your_second_password

# Secret used to sign the app session cookie.
AUTH_SECRET=your_long_random_secret

# Secret used by the GitHub Action to call POST /api/news/cron-sync.
NEWS_SYNC_CRON_SECRET=your_news_sync_secret

# 0 for local HTTP development, 1 for HTTPS deployments.
AUTH_COOKIE_SECURE=0

# MongoDB connection for the optional second signed-in user.
MONGO_URI_2=mongodb://127.0.0.1:27017/trade-journal-user-2

# Cloudflare R2 storage for trade and pyramid screenshots.
# Endpoint uses https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com with region "auto".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public base URL for viewing uploaded screenshots.
# This should match the public URL for the same bucket used by trade and pyramid image uploads.
# Use either your bucket custom domain or the public r2.dev URL, for example:
# https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=
